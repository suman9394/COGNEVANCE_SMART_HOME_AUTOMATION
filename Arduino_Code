#include <DHT.h>

// ================================
// PIN DEFINITIONS
// ================================

#define DHT_PIN 2
#define DHT_TYPE DHT22

#define LDR_PIN A0
#define PIR_PIN 3

#define RELAY_PIN 4

#define LIGHT_LED 5
#define FAN_LED 6

// ================================
// DHT22
// ================================

DHT dht(DHT_PIN, DHT_TYPE);

// ================================
// SETTINGS
// ================================

// Temperature limits
const float FAN_ON_TEMP = 30.0;
const float FAN_OFF_TEMP = 28.0;

// LDR threshold
const int LIGHT_THRESHOLD = 500;

// ================================
// VARIABLES
// ================================

float temperature;
float humidity;

int lightValue;
int motionValue;

bool fanState = false;
bool lightState = false;

// ================================
// SETUP
// ================================

void setup() {

  Serial.begin(9600);

  dht.begin();

  pinMode(LDR_PIN, INPUT);
  pinMode(PIR_PIN, INPUT);

  pinMode(RELAY_PIN, OUTPUT);
  pinMode(LIGHT_LED, OUTPUT);
  pinMode(FAN_LED, OUTPUT);

  // Initial state
  digitalWrite(RELAY_PIN, LOW);
  digitalWrite(LIGHT_LED, LOW);
  digitalWrite(FAN_LED, LOW);

  Serial.println("==================================");
  Serial.println("   SMART HOME AUTOMATION SYSTEM");
  Serial.println("==================================");
  Serial.println("System Started");
  Serial.println();
}

// ================================
// MAIN LOOP
// ================================

void loop() {

  // ------------------------------
  // READ DHT22
  // ------------------------------

  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  // ------------------------------
  // READ LDR
  // ------------------------------

  lightValue = analogRead(LDR_PIN);

  // ------------------------------
  // READ PIR
  // ------------------------------

  motionValue = digitalRead(PIR_PIN);

  // ------------------------------
  // DISPLAY SENSOR DATA
  // ------------------------------

  Serial.println("----------------------------------");

  if (isnan(temperature) || isnan(humidity)) {

    Serial.println("DHT22: Sensor Error");

  } else {

    Serial.print("Temperature : ");
    Serial.print(temperature);
    Serial.println(" °C");

    Serial.print("Humidity    : ");
    Serial.print(humidity);
    Serial.println(" %");
  }

  Serial.print("Light Value : ");
  Serial.println(lightValue);

  Serial.print("Motion      : ");

  if (motionValue == HIGH) {
    Serial.println("DETECTED");
  } else {
    Serial.println("NOT DETECTED");
  }

  // ==================================
  // AUTOMATIC FAN CONTROL
  // ==================================

  if (!isnan(temperature)) {

    // Turn fan ON
    if (temperature >= FAN_ON_TEMP) {

      fanState = true;

    }

    // Turn fan OFF
    else if (temperature <= FAN_OFF_TEMP) {

      fanState = false;

    }
  }

  // Apply fan state

  if (fanState) {

    digitalWrite(RELAY_PIN, HIGH);
    digitalWrite(FAN_LED, HIGH);

    Serial.println("Fan         : ON");

  } else {

    digitalWrite(RELAY_PIN, LOW);
    digitalWrite(FAN_LED, LOW);

    Serial.println("Fan         : OFF");
  }

  // ==================================
  // AUTOMATIC LIGHT CONTROL
  // ==================================

  if (lightValue < LIGHT_THRESHOLD) {

    lightState = true;

  } else {

    lightState = false;
  }

  if (lightState) {

    digitalWrite(LIGHT_LED, HIGH);

    Serial.println("Light       : ON");

  } else {

    digitalWrite(LIGHT_LED, LOW);

    Serial.println("Light       : OFF");
  }

  // ==================================
  // MOTION STATUS
  // ==================================

  if (motionValue == HIGH) {

    Serial.println("Alert       : Motion Detected!");

  } else {

    Serial.println("Alert       : No Motion");
  }

  Serial.println("----------------------------------");

  delay(2000);
}
